<?xml version="1.0"?>
<robot name="mi_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="rueda_radio" value="0.05"/>
  <xacro:property name="rueda_ancho" value="0.03"/>
  <xacro:property name="separacion_ruedas" value="0.25"/>

  <link name="base_link">
    <visual>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
      <material name="azul"><color rgba="0.2 0.4 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="0.3 0.2 0.1"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia
        ixx="${1.0*(0.2*0.2 + 0.1*0.1)/12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${1.0*(0.3*0.3 + 0.1*0.1)/12.0}"
        iyz="0.0"
        izz="${1.0*(0.3*0.3 + 0.2*0.2)/12.0}"/>
    </inertial>
  </link>

  <xacro:macro name="rueda" params="prefijo y_signo">
    <link name="rueda_${prefijo}">
      <visual>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
        <material name="negro"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia
          ixx="${0.1*(3*rueda_radio*rueda_radio + rueda_ancho*rueda_ancho)/12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${0.1*(3*rueda_radio*rueda_radio + rueda_ancho*rueda_ancho)/12.0}"
          iyz="0.0"
          izz="${0.1*rueda_radio*rueda_radio/2.0}"/>
      </inertial>
    </link>

    <joint name="joint_rueda_${prefijo}" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${prefijo}"/>
      <origin xyz="0 ${y_signo * separacion_ruedas/2} -0.02" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:rueda prefijo="izq" y_signo="1"/>
  <xacro:rueda prefijo="der" y_signo="-1"/>
  <xacro:property name="caster_radio" value="0.015"/>
  <xacro:property name="caster_masa" value="0.05"/>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radio}"/>
      </geometry>
      <material name="negro"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="${caster_radio}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${caster_masa}"/>
      <inertia
        ixx="${2.0*caster_masa*caster_radio*caster_radio/5.0}"
        ixy="0"
        ixz="0"
        iyy="${2.0*caster_masa*caster_radio*caster_radio/5.0}"
        iyz="0"
        izz="${2.0*caster_masa*caster_radio*caster_radio/5.0}"/>
    </inertial>
  </link>

  <joint name="joint_caster" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="0.12 0 -0.055" rpy="0 0 0"/>
  </joint>



  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry></visual>
    <collision><geometry><cylinder radius="0.03" length="0.04"/></geometry></collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="${0.05*(3*0.03*0.03 + 0.04*0.04)/12.0}" ixy="0" ixz="0" iyy="${0.05*(3*0.03*0.03 + 0.04*0.04)/12.0}" iyz="0" izz="${0.05*0.03*0.03/2.0}"/>
    </inertial>

  </link>

  <joint name="joint_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.1 0 0.07" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.02 0.05 0.02"/></geometry></visual>
    <collision><geometry><box size="0.02 0.05 0.02"/></geometry></collision>
    <inertial>
      <mass value="0.02"/>
      <inertia
        ixx="${0.02*(0.05*0.05 + 0.02*0.02)/12.0}"
        ixy="0"
        ixz="0"
        iyy="${0.02*(0.02*0.02 + 0.02*0.02)/12.0}"
        iyz="0"
        izz="${0.02*(0.02*0.02 + 0.05*0.05)/12.0}"/>
    </inertial>
  </link>
  <joint name="joint_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.15 0 0.03" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_link"/>

  <joint name="joint_camera_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>


  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_rueda_izq</left_joint>
      <right_joint>joint_rueda_der</right_joint>
      <wheel_separation>${separacion_ruedas}</wheel_separation>
      <wheel_radius>${rueda_radio}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/world/pista/model/mi_robot/joint_state</topic>
      <joint_name>joint_rueda_izq</joint_name>
      <joint_name>joint_rueda_der</joint_name>
    </plugin>
  </gazebo>

  
  <gazebo reference="caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camara" type="camera">
      <topic>image_raw</topic>
      <gz_frame_id>camera_optical_link</gz_frame_id>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>20</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>